{"ok":true,"data":{"kind":"command","command":"member tag","summary":"Add a tag to a member","effect":"write","idempotency":"replay-safe","operands":[{"name":"number","valueType":"integer","required":true,"help":"The member's number","domain":{"minimum":1}}],"options":[{"name":"tag","required":true,"domain":{"pattern":"^[a-z][a-z0-9-]*$","notOneOf":["admin"]},"help":"The tag to add"},{"name":"by","valueName":"EMAIL","domain":{"format":"email","maxLength":254},"help":"Who adds the tag, an email address (recorded, not checked)"}],"validators":[{"arguments":["tag"],"code":"TAG_INVALID","description":"The tags admin and owner are reserved for the directory and cannot be added by hand. The domain's pattern admits them; this check refuses them.","rejects":["acme member tag 7 --tag admin --json"]}],"errors":["MEMBER_NOT_FOUND","TAG_INVALID"],"outputs":[{"schemaRef":"#/schemas/MemberTagReport"},{"schemaRef":"#/schemas/BatchMemberTagReport","batch":true,"when":"--input is an array"}],"input":{"argumentsRef":"#/schemas/MemberTagArguments","batch":true,"maxBytes":65536,"maxItems":100,"example":{"operands":[7],"tag":"core"}},"examples":["acme member tag 7 --tag core --json","acme member tag --input '[{\"operands\":[7],\"tag\":\"core\"},{\"operands\":[\"8\"],\"tag\":\"lead\"}]' --json"]},"meta":{"command":"schema","contract":"atip/1","contractVersion":"1.6","schemaVersion":"1.6","tool":"acme","toolVersion":"1.0.0"}}
