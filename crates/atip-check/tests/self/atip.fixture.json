{
  "commands": {
    "check": {
      "missingValue": [
        [
          "check",
          "--level",
          "L0",
          "--fixture",
          "atip.fixture.json",
          "--json"
        ]
      ],
      "ok": [
        [
          "check",
          "--bin",
          "atip",
          "--fixture",
          "atip.fixture.json",
          "--level",
          "L0",
          "--json"
        ]
      ],
      "refused": [
        [
          "check",
          "--json"
        ]
      ]
    },
    "schema": {
      "ok": [
        [
          "schema",
          "--json"
        ]
      ],
      "refused": [
        [
          "schema",
          "nosuch-xyz",
          "--json"
        ]
      ]
    },
    "skills show": {
      "ok": [
        [
          "skills",
          "show",
          "--json"
        ]
      ],
      "refused": [
        [
          "skills",
          "show",
          "nosuch-xyz",
          "--json"
        ]
      ]
    }
  },
  "contractVersion": "1.6",
  "env": {
    "TMPDIR": "."
  },
  "globalOptions": [],
  "prepare": [
    [
      "sh",
      "-c",
      "printf '%s\\n' '{\"commands\":{\"check\":{\"missingValue\":[[\"check\",\"--level\",\"L0\",\"--fixture\",\"atip.fixture.json\",\"--json\"]]}},\"contractVersion\":\"1.6\",\"globalOptions\":[],\"probe\":\"check\",\"registry\":\"from-schema\"}' > atip.fixture.json"
    ]
  ],
  "probe": "check",
  "registry": [
    {
      "code": "BINARY_INVALID",
      "exit": 2,
      "retryable": false
    },
    {
      "code": "COMMAND_REQUIRED",
      "exit": 2,
      "retryable": false
    },
    {
      "code": "FIXTURE_INVALID",
      "exit": 2,
      "reasons": [
        "NOT_JSON",
        "PREPARE_FAILED",
        "SETUP_FAILED",
        "UNREADABLE",
        "WRONG_SHAPE"
      ],
      "retryable": false
    },
    {
      "code": "INTERNAL",
      "exit": 1,
      "retryable": false
    },
    {
      "code": "LEVEL_FAILED",
      "exit": 1,
      "retryable": false
    },
    {
      "code": "SCRATCH_FAILED",
      "exit": 1,
      "retryable": true
    },
    {
      "code": "SCRATCH_UNAVAILABLE",
      "exit": 2,
      "retryable": true
    },
    {
      "code": "UNKNOWN_COMMAND",
      "exit": 2,
      "retryable": false
    },
    {
      "code": "USAGE",
      "exit": 2,
      "retryable": false
    }
  ],
  "warnings": [
    "SHOULD_FAILED"
  ]
}
