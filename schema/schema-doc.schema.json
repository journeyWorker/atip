{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://atip.dev/1/schema-doc.schema.json",
  "title": "atip/1 self-description (`<tool> schema ... --json`)",
  "description": "A successful `schema` answer (spec section 9). `data.kind` selects one of eight documents (`warnings` and `warning` since 1.1, `schemas` since 1.4). Covers every minor of this major (spec 15.6): a member a 1.4 document omits at its default is not `required` and states its `default`; a member a 1.4 document no longer carries is not `required` and has `x-atip-until: \"1.3\"`; a member added later has `x-atip-since`. What a document of 1.0-1.3 must still carry (the members `required` before 1.4), and what only 1.4 may use, is checked by scripts/check.ts (Annex S2 rules 16 and 17). Closed for tools of the current minor; callers read it open (spec 15.6). Level-neutral: rules that apply only at L2 (spec 11.4) are checked by the L2 checker, not here (spec 3.3). Rules JSON Schema cannot express are listed in Annex S2.",
  "allOf": [
    { "$ref": "envelope.schema.json#/$defs/success" },
    {
      "type": "object",
      "properties": {
        "meta": {
          "type": "object",
          "required": ["command", "contract"],
          "properties": {
            "command": { "const": "schema" }
          }
        },
        "data": {
          "oneOf": [
            { "$ref": "#/$defs/tree" },
            { "$ref": "#/$defs/group" },
            { "$ref": "#/$defs/command" },
            { "$ref": "#/$defs/errors" },
            { "$ref": "#/$defs/error" },
            { "$ref": "#/$defs/warnings" },
            { "$ref": "#/$defs/warning" },
            { "$ref": "#/$defs/schemas" }
          ]
        }
      }
    }
  ],
  "$defs": {
    "xKeys": {
      "type": "string",
      "pattern": "^x-[a-z][a-z0-9-]*$"
    },
    "word": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
    },
    "commandId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*( [a-z][a-z0-9]*(-[a-z0-9]+)*)*$"
    },
    "path": {
      "type": "array",
      "items": { "$ref": "#/$defs/word" },
      "minItems": 1
    },
    "effect": { "enum": ["read", "write", "destructive"] },
    "idempotency": { "enum": ["replay-safe", "content-keyed", "appends", "once"] },
    "valueName": {
      "description": "The placeholder shown in help: upper case, with the separators of composite placeholders (`JSON|FILE|-`, `GROUP:VALUE`, `PATH=TEXT`).",
      "type": "string",
      "pattern": "^[A-Z0-9_|:=@.-]*[A-Z][A-Z0-9_|:=@.-]*$"
    },
    "optionName": {
      "description": "The long name of an option without `--`. Lower kebab case; an identifier option is the bare noun, never `<noun>-id`.",
      "allOf": [
        { "$ref": "#/$defs/word" },
        { "not": { "pattern": "-id$" } }
      ]
    },
    "treeEntry": {
      "type": "object",
      "required": ["command", "summary"],
      "properties": {
        "command": { "$ref": "#/$defs/commandId" },
        "path": {
          "description": "The words of `command`; before 1.4 only.",
          "x-atip-until": "1.3",
          "$ref": "#/$defs/path"
        },
        "kind": { "enum": ["group", "command"], "default": "command" },
        "summary": { "type": "string", "minLength": 1 },
        "effect": { "$ref": "#/$defs/effect" }
      },
      "allOf": [
        {
          "if": { "required": ["kind"], "properties": { "kind": { "const": "group" } } },
          "then": { "not": { "required": ["effect"] } },
          "else": { "required": ["effect"] }
        }
      ],
      "patternProperties": { "^x-[a-z][a-z0-9-]*$": true },
      "additionalProperties": false
    },
    "tree": {
      "type": "object",
      "required": ["kind", "level", "commands"],
      "properties": {
        "kind": { "const": "tree" },
        "level": { "enum": ["L1", "L2"] },
        "options": {
          "description": "The options commands share, defined once; a command document names them (spec 9.3, 9.5). Absent when none.",
          "x-atip-since": "1.4",
          "type": "array",
          "items": { "$ref": "#/$defs/option" },
          "minItems": 1
        },
        "query": {
          "description": "Present only on a `schema --search` answer; `commands` is then ranked best first and may be empty.",
          "type": "string",
          "minLength": 1
        },
        "commands": {
          "type": "array",
          "items": { "$ref": "#/$defs/treeEntry" }
        }
      },
      "allOf": [
        {
          "if": { "not": { "required": ["query"] } },
          "then": { "properties": { "commands": { "minItems": 1 } } }
        }
      ],
      "patternProperties": { "^x-[a-z][a-z0-9-]*$": true },
      "additionalProperties": false
    },
    "group": {
      "type": "object",
      "required": ["kind", "command", "summary", "commands"],
      "properties": {
        "kind": { "const": "group" },
        "command": { "$ref": "#/$defs/commandId" },
        "path": {
          "description": "The words of `command`; before 1.4 only.",
          "x-atip-until": "1.3",
          "$ref": "#/$defs/path"
        },
        "summary": { "type": "string", "minLength": 1 },
        "commands": {
          "type": "array",
          "items": { "$ref": "#/$defs/treeEntry" },
          "minItems": 1
        }
      },
      "patternProperties": { "^x-[a-z][a-z0-9-]*$": true },
      "additionalProperties": false
    },
    "errors": {
      "type": "object",
      "required": ["kind", "errors"],
      "properties": {
        "kind": { "const": "errors" },
        "errors": {
          "type": "array",
          "items": { "$ref": "registry-entry.schema.json" },
          "minItems": 1
        }
      },
      "additionalProperties": false
    },
    "error": {
      "type": "object",
      "required": ["kind", "error"],
      "properties": {
        "kind": { "const": "error" },
        "error": { "$ref": "registry-entry.schema.json" }
      },
      "additionalProperties": false
    },
    "warnings": {
      "description": "The warning registry (spec 7.5.2).",
      "x-atip-since": "1.1",
      "type": "object",
      "required": ["kind", "warnings"],
      "properties": {
        "kind": { "const": "warnings" },
        "warnings": {
          "type": "array",
          "items": { "$ref": "warning-entry.schema.json" },
          "minItems": 1
        }
      },
      "additionalProperties": false
    },
    "warning": {
      "description": "One warning registry entry (spec 7.5.2).",
      "x-atip-since": "1.1",
      "type": "object",
      "required": ["kind", "warning"],
      "properties": {
        "kind": { "const": "warning" },
        "warning": { "$ref": "warning-entry.schema.json" }
      },
      "additionalProperties": false
    },
    "schemas": {
      "description": "The JSON Schemas a command document's refs reach, and nothing else (spec 9.9.3).",
      "x-atip-since": "1.4",
      "type": "object",
      "required": ["kind", "command", "schemas"],
      "properties": {
        "kind": { "const": "schemas" },
        "command": { "$ref": "#/$defs/commandId" },
        "schemas": { "$ref": "#/$defs/schemaMap" }
      },
      "additionalProperties": false
    },
    "schemaMap": {
      "description": "JSON Schemas keyed by name; `#/schemas/X` resolves against this object.",
      "type": "object",
      "propertyNames": { "pattern": "^[A-Za-z][A-Za-z0-9]*$" },
      "additionalProperties": { "type": ["object", "boolean"] },
      "minProperties": 1
    },
    "command": {
      "type": "object",
      "required": ["kind", "command", "summary", "effect", "outputs", "examples"],
      "properties": {
        "kind": { "const": "command" },
        "command": { "$ref": "#/$defs/commandId" },
        "path": {
          "description": "The words of `command`; before 1.4 only.",
          "x-atip-until": "1.3",
          "$ref": "#/$defs/path"
        },
        "summary": { "type": "string", "minLength": 1 },
        "effect": { "$ref": "#/$defs/effect" },
        "idempotency": { "$ref": "#/$defs/idempotency" },
        "effectNote": {
          "description": "Effects of a successful run the effect class does not say. Never permits a refusal or preview to write (spec 11.2).",
          "type": "string",
          "minLength": 1
        },
        "async": {
          "description": "true: exit 0 means accepted, not done (spec 12.2).",
          "type": "boolean",
          "default": false
        },
        "operands": {
          "type": "array",
          "items": { "$ref": "#/$defs/operand" },
          "default": []
        },
        "options": {
          "description": "The command's own options, and the names of the tree options it shares (since 1.4). A 1.4 document does not list the reserved options its document implies (spec 9.5); an earlier document lists every option the command accepts.",
          "type": "array",
          "items": {
            "oneOf": [
              { "$ref": "#/$defs/option" },
              {
                "description": "The name of a tree option (spec 9.3).",
                "x-atip-since": "1.4",
                "$ref": "#/$defs/optionName"
              }
            ]
          },
          "default": []
        },
        "constraints": {
          "type": "array",
          "items": { "$ref": "#/$defs/constraint" },
          "minItems": 1
        },
        "validators": {
          "type": "array",
          "items": { "$ref": "#/$defs/validator" },
          "minItems": 1
        },
        "errors": {
          "description": "Every error code the command can emit; a 1.4 document leaves out the implied ones (spec 9.5). Exits are in the registry.",
          "type": "array",
          "items": { "$ref": "error.schema.json#/$defs/code" },
          "minItems": 1,
          "uniqueItems": true,
          "default": []
        },
        "outputs": {
          "type": "array",
          "items": { "$ref": "#/$defs/output" },
          "minItems": 1
        },
        "input": { "$ref": "#/$defs/input" },
        "examples": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        },
        "schemas": {
          "description": "Every JSON Schema the command's refs name, keyed by name; `#/schemas/X` resolves against `data`. Before 1.4 only: since 1.4 the schemas answer holds them (spec 9.9.3).",
          "x-atip-until": "1.3",
          "$ref": "#/$defs/schemaMap"
        }
      },
      "allOf": [
        {
          "if": { "properties": { "effect": { "const": "read" } } },
          "then": { "not": { "required": ["idempotency"] } },
          "else": { "required": ["idempotency"] }
        },
        {
          "if": {
            "required": ["input"],
            "properties": { "input": { "required": ["batch"], "properties": { "batch": { "const": true } } } }
          },
          "then": {
            "properties": {
              "outputs": { "contains": { "type": "object", "properties": { "batch": { "const": true } }, "required": ["batch"] } }
            }
          },
          "else": {
            "properties": {
              "outputs": { "not": { "contains": { "type": "object", "properties": { "batch": { "const": true } }, "required": ["batch"] } } }
            }
          }
        },
        {
          "if": { "properties": { "async": { "const": true } }, "required": ["async"] },
          "then": { "properties": { "effect": { "enum": ["write", "destructive"] } } }
        }
      ],
      "patternProperties": { "^x-[a-z][a-z0-9-]*$": true },
      "additionalProperties": false
    },
    "operand": {
      "type": "object",
      "required": ["name", "help"],
      "properties": {
        "name": { "$ref": "#/$defs/word" },
        "valueName": {
          "description": "Default: the name in upper case, `-` written `_`.",
          "$ref": "#/$defs/valueName"
        },
        "valueType": { "enum": ["string", "integer", "number", "path", "enum", "json"], "default": "string" },
        "possibleValues": { "$ref": "#/$defs/possibleValues" },
        "required": { "type": "boolean", "default": false },
        "variadic": { "type": "boolean", "default": false },
        "default": {
          "description": "The typed value used when the operand is absent; null (the default) for none.",
          "default": null
        },
        "defaultNote": { "type": "string", "minLength": 1 },
        "domain": { "$ref": "#/$defs/domain" },
        "help": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        { "$ref": "#/$defs/enumNeedsValues" },
        { "$ref": "#/$defs/requiredHasNoDefault" },
        {
          "$ref": "#/$defs/typedDefault",
          "description": "operand defaults are typed like option defaults; variadic plays the role of repeatable"
        },
        {
          "if": { "required": ["variadic"], "properties": { "variadic": { "const": true } } },
          "then": { "properties": { "default": { "type": ["array", "null"] } } },
          "else": {
            "if": { "properties": { "valueType": { "not": { "const": "json" } } } },
            "then": { "properties": { "default": { "not": { "type": "array" } } } }
          }
        }
      ],
      "patternProperties": { "^x-[a-z][a-z0-9-]*$": true },
      "additionalProperties": false
    },
    "option": {
      "type": "object",
      "required": ["name", "help"],
      "properties": {
        "name": { "$ref": "#/$defs/optionName" },
        "short": { "type": "string", "pattern": "^[a-zA-Z]$" },
        "valueName": {
          "description": "Default: the name in upper case, `-` written `_`; a switch and a count have none.",
          "$ref": "#/$defs/valueName"
        },
        "valueType": { "enum": ["switch", "count", "string", "integer", "number", "path", "enum", "json"], "default": "string" },
        "possibleValues": { "$ref": "#/$defs/possibleValues" },
        "required": { "type": "boolean", "default": false },
        "repeatable": {
          "description": "A count is repeatable by definition and does not say so (1.4).",
          "type": "boolean",
          "default": false
        },
        "default": {
          "description": "The typed value used when the option is absent, or null when there is none (or it is computed: see defaultNote). Absent in 1.4 when null, `false` for a switch or `0` for a count.",
          "default": null
        },
        "defaultNote": { "type": "string", "minLength": 1 },
        "domain": { "$ref": "#/$defs/domain" },
        "env": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
        "flagOnly": {
          "description": "true: the option cannot appear in an --input document (spec 10.6). Required for json, input, commit and plan-digest; in a document that declares 1.2 also for limit, cursor, all and fields, which depends on the declared minor and is checked by scripts/check.ts (spec Annex S2 rule 8).",
          "type": "boolean",
          "default": false
        },
        "help": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": { "required": ["valueType"], "properties": { "valueType": { "enum": ["switch", "count"] } } },
          "then": { "not": { "anyOf": [{ "required": ["valueName"] }, { "required": ["possibleValues"] }] } }
        },
        {
          "if": { "required": ["valueType"], "properties": { "valueType": { "const": "switch" } } },
          "then": {
            "properties": {
              "required": { "const": false },
              "repeatable": { "const": false },
              "default": { "const": false }
            }
          }
        },
        {
          "if": { "required": ["valueType"], "properties": { "valueType": { "const": "count" } } },
          "then": {
            "properties": {
              "required": { "const": false },
              "repeatable": { "const": true },
              "default": { "type": "integer", "minimum": 0 }
            }
          }
        },
        { "$ref": "#/$defs/enumNeedsValues" },
        { "$ref": "#/$defs/requiredHasNoDefault" },
        { "$ref": "#/$defs/typedDefault" },
        {
          "if": {
            "required": ["repeatable"],
            "properties": {
              "valueType": { "not": { "enum": ["switch", "count"] } },
              "repeatable": { "const": true }
            }
          },
          "then": { "properties": { "default": { "type": ["array", "null"] } } }
        },
        {
          "if": {
            "properties": {
              "valueType": { "enum": ["string", "integer", "number", "path", "enum"] },
              "repeatable": { "const": false }
            }
          },
          "then": { "properties": { "default": { "not": { "type": "array" } } } }
        },
        {
          "if": { "properties": { "name": { "enum": ["json", "input", "commit", "plan-digest"] } } },
          "then": { "required": ["flagOnly"], "properties": { "flagOnly": { "const": true } } }
        }
      ],
      "patternProperties": { "^x-[a-z][a-z0-9-]*$": true },
      "additionalProperties": false
    },
    "possibleValues": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1,
      "uniqueItems": true
    },
    "domain": {
      "description": "The interoperable domain profile (Annex V1): which keywords fit which valueType, safe-integer bounds and the I-Regexp form of `pattern` are checked by scripts/check.ts (spec Annex S2 rule 3).",
      "$ref": "#/$defs/domainNode",
      "minProperties": 1
    },
    "domainNode": {
      "type": "object",
      "properties": {
        "minimum": { "type": "number" },
        "maximum": { "type": "number" },
        "exclusiveMinimum": { "type": "number" },
        "exclusiveMaximum": { "type": "number" },
        "multipleOf": { "type": "number", "exclusiveMinimum": 0 },
        "minLength": { "type": "integer", "minimum": 0 },
        "maxLength": { "type": "integer", "minimum": 0 },
        "pattern": {
          "description": "`^`, an I-Regexp (RFC 9485) body with the restrictions of Annex V2, and `$`.",
          "type": "string",
          "pattern": "^\\^.*\\$$"
        },
        "type": {
          "anyOf": [
            { "$ref": "#/$defs/jsonType" },
            { "type": "array", "items": { "$ref": "#/$defs/jsonType" }, "minItems": 1, "uniqueItems": true }
          ]
        },
        "enum": { "type": "array", "items": { "$ref": "#/$defs/scalar" }, "minItems": 1, "uniqueItems": true },
        "const": { "$ref": "#/$defs/scalar" },
        "properties": { "type": "object", "additionalProperties": { "$ref": "#/$defs/domainNode" } },
        "required": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "additionalProperties": { "anyOf": [{ "type": "boolean" }, { "$ref": "#/$defs/domainNode" }] },
        "items": { "$ref": "#/$defs/domainNode" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "$comment": { "type": "string" },
        "format": {
          "description": "An annotation only: it asserts nothing (Annex V1).",
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "jsonType": { "enum": ["null", "boolean", "object", "array", "number", "string", "integer"] },
    "scalar": { "type": ["null", "boolean", "number", "string"] },
    "validator": {
      "description": "A stateless check outside the domain profile and the constraint vocabulary (spec 9.8.2).",
      "type": "object",
      "required": ["arguments", "code", "description", "rejects"],
      "properties": {
        "arguments": {
          "type": "array",
          "items": { "$ref": "#/$defs/word" },
          "minItems": 1,
          "uniqueItems": true
        },
        "code": { "$ref": "error.schema.json#/$defs/code" },
        "description": { "type": "string", "minLength": 1 },
        "rejects": {
          "description": "Complete invocations that satisfy every declared requirement, constraint and domain and that this validator refuses.",
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        }
      },
      "patternProperties": { "^x-[a-z][a-z0-9-]*$": true },
      "additionalProperties": false
    },
    "enumNeedsValues": {
      "if": { "required": ["valueType"], "properties": { "valueType": { "const": "enum" } } },
      "then": { "required": ["possibleValues"] },
      "else": { "not": { "required": ["possibleValues"] } }
    },
    "requiredHasNoDefault": {
      "if": { "required": ["required"], "properties": { "required": { "const": true } } },
      "then": { "properties": { "default": { "const": null } } }
    },
    "typedDefault": {
      "allOf": [
        {
          "if": { "required": ["valueType"], "properties": { "valueType": { "const": "integer" } } },
          "then": { "properties": { "default": { "$ref": "#/$defs/defaultInteger" } } }
        },
        {
          "if": { "required": ["valueType"], "properties": { "valueType": { "const": "number" } } },
          "then": { "properties": { "default": { "$ref": "#/$defs/defaultNumber" } } }
        },
        {
          "if": { "properties": { "valueType": { "enum": ["string", "path", "enum"] } } },
          "then": { "properties": { "default": { "$ref": "#/$defs/defaultString" } } }
        }
      ]
    },
    "defaultInteger": {
      "anyOf": [
        { "type": "null" },
        { "type": "integer" },
        { "type": "array", "items": { "type": "integer" } }
      ]
    },
    "defaultNumber": {
      "anyOf": [
        { "type": "null" },
        { "type": "number" },
        { "type": "array", "items": { "type": "number" } }
      ]
    },
    "defaultString": {
      "anyOf": [
        { "type": "null" },
        { "type": "string" },
        { "type": "array", "items": { "type": "string" } }
      ]
    },
    "constraint": {
      "type": "object",
      "required": ["rule"],
      "properties": {
        "rule": { "enum": ["atLeastOne", "exactlyOne", "atMostOne", "requires", "forbids"] },
        "names": {
          "type": "array",
          "items": { "$ref": "#/$defs/word" },
          "minItems": 2,
          "uniqueItems": true
        },
        "if": {
          "type": "object",
          "required": ["name"],
          "properties": {
            "name": { "$ref": "#/$defs/word" },
            "in": {
              "type": "array",
              "items": { "type": ["string", "number"] },
              "minItems": 1,
              "uniqueItems": true
            }
          },
          "additionalProperties": false
        },
        "then": {
          "type": "array",
          "items": { "$ref": "#/$defs/word" },
          "minItems": 1,
          "uniqueItems": true
        },
        "code": { "$ref": "error.schema.json#/$defs/code" },
        "help": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "rule": { "enum": ["atLeastOne", "exactlyOne", "atMostOne"] } } },
          "then": { "required": ["names"], "not": { "anyOf": [{ "required": ["if"] }, { "required": ["then"] }] } },
          "else": { "required": ["if", "then"], "not": { "required": ["names"] } }
        }
      ],
      "patternProperties": { "^x-[a-z][a-z0-9-]*$": true },
      "additionalProperties": false
    },
    "schemaRef": {
      "type": "string",
      "pattern": "^#/schemas/[A-Za-z][A-Za-z0-9]*$"
    },
    "output": {
      "type": "object",
      "required": ["schemaRef"],
      "properties": {
        "kind": { "enum": ["report", "artifact", "stream"], "default": "report" },
        "schemaRef": {
          "description": "The JSON Schema of `data` in JSON mode (for a stream: of the end line's result data); `#/schemas/X` resolves in the command document's `schemas` before 1.4, in the schemas answer since (spec 9.9.3).",
          "$ref": "#/$defs/schemaRef"
        },
        "schemaVersion": { "$ref": "envelope.schema.json#/$defs/schemaVersion", "default": "1.0" },
        "mediaType": {
          "description": "Text-mode bytes of an artifact; application/x-ndjson for a stream.",
          "type": "string",
          "pattern": "^[a-z]+/[a-zA-Z0-9.+-]+$"
        },
        "eventRef": {
          "description": "A stream's event line data schema.",
          "$ref": "#/$defs/schemaRef"
        },
        "batch": { "type": "boolean" },
        "when": { "type": "string", "minLength": 1 },
        "fields": {
          "description": "Field selection (spec 6.10).",
          "type": "object",
          "required": ["records", "paths"],
          "properties": {
            "records": { "description": "RFC 6901 JSON pointer of the record array in data, or \"\" when data is the record.", "type": "string", "pattern": "^(/([^~]|~[01])*)*$" },
            "paths": { "type": "array", "items": { "$ref": "envelope.schema.json#/$defs/fieldPath" }, "minItems": 1, "uniqueItems": true },
            "keep": { "type": "array", "items": { "$ref": "envelope.schema.json#/$defs/fieldPath" }, "uniqueItems": true },
            "default": { "type": "array", "items": { "$ref": "envelope.schema.json#/$defs/fieldPath" }, "minItems": 1, "uniqueItems": true }
          },
          "additionalProperties": false
        }
      },
      "allOf": [
        {
          "if": { "required": ["kind"], "properties": { "kind": { "const": "artifact" } } },
          "then": { "required": ["mediaType"], "not": { "required": ["eventRef"] } }
        },
        {
          "if": { "required": ["kind"], "properties": { "kind": { "const": "stream" } } },
          "then": { "required": ["mediaType", "eventRef"], "properties": { "mediaType": { "const": "application/x-ndjson" } } }
        },
        {
          "if": { "not": { "required": ["kind"], "properties": { "kind": { "enum": ["artifact", "stream"] } } } },
          "then": { "not": { "anyOf": [{ "required": ["mediaType"] }, { "required": ["eventRef"] }] } }
        }
      ],
      "patternProperties": { "^x-[a-z][a-z0-9-]*$": true },
      "additionalProperties": false
    },
    "input": {
      "type": "object",
      "required": ["maxBytes", "example"],
      "properties": {
        "option": {
          "description": "Always `--input`; before 1.4 only.",
          "x-atip-until": "1.3",
          "const": "--input"
        },
        "schemaRef": {
          "description": "The declared fragment schema of one document, before 1.4 only: since 1.4 it is derived from the options (spec 9.9.2).",
          "x-atip-until": "1.3",
          "$ref": "#/$defs/schemaRef"
        },
        "argumentsRef": {
          "description": "Informative schema of the complete merged arguments.",
          "$ref": "#/$defs/schemaRef"
        },
        "batch": { "type": "boolean", "default": false },
        "maxBytes": { "type": "integer", "minimum": 1 },
        "maxItems": { "type": "integer", "minimum": 1 },
        "example": { "$ref": "input-document.schema.json#/$defs/document" }
      },
      "allOf": [
        {
          "if": { "required": ["batch"], "properties": { "batch": { "const": true } } },
          "then": { "required": ["maxItems"] },
          "else": { "not": { "required": ["maxItems"] } }
        }
      ],
      "additionalProperties": false
    }
  }
}
